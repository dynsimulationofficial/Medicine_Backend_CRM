# Server Configuration
NODE_ENV=development
MANAGE_LEAD_PORT=8016
JWT_SECRET=your_jwt_secret_key

# PostgreSQL Database (Writer)
PGHOST_WRITER=localhost
PGPORT_WRITER=5432
PGUSER_WRITER=postgres
PGPASSWORD_WRITER=postgres
PGDATABASE_WRITER=medicine_crm_db
PGMAXCONNECTIONS_WRITER=50
PGMINCONNECTIONS_WRITER=2

# PostgreSQL Database (Reader)
PGHOST_READER=localhost
PGPORT_READER=5432
PGUSER_READER=postgres
PGPASSWORD_READER=postgres
PGDATABASE_READER=medicine_crm_db
PGMAXCONNECTIONS_READER=50
PGMINCONNECTIONS_READER=2

# SSL Configuration
PG_USE_SSL=false

# SMTP Configuration (Optional/Required by EmailService)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Medicine CRM <your_email@gmail.com>"
ADMIN_NOTIFY_TO=admin@example.com

# Sentry (Optional)
SENTRY_DSN=
